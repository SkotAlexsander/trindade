# Capturas dos roteiros de e2e. Elas nascem na pasta que se passa como
# argumento, e quem esquece o argumento as despeja na raiz — foi assim que
# quatorze PNGs acabaram versionados sem ninguém decidir isso.
/*.png

# Fixturas e cache gerados pelos roteiros de e2e.
e2e/.tmp/
e2e/__pycache__/

# Dumps do banco. Ficam no disco e no storage, nunca no repositório.
backups/

# A configuração do coturn com o segredo já substituído. O modelo é
# `infra/turnserver.conf`, versionado; este nasce no `implantar.sh`.
infra/turnserver.rendered.conf

# Fontes do Excalidraw, copiadas do pacote instalado por
# packages/web/scripts/fontes-do-quadro.mjs antes de `dev` e de `build`.
packages/web/public/excalidraw/

# Compilação do Rust. 1,5 GB de artefato que se refaz com `cargo build`.
packages/desktop/src-tauri/target/
packages/desktop/src-tauri/gen/
