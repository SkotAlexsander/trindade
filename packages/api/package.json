{
  "name": "@trindade/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node --import tsx ./src/scripts/migrate.ts",
    "bootstrap": "tsx src/scripts/bootstrap.ts",
    "dev:admin": "tsx src/scripts/dev-admin.ts",
    "dev:seed": "tsx src/scripts/dev-seed.ts",
    "keygen": "tsx src/scripts/keygen.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@trindade/shared": "workspace:*",
    "argon2": "^0.41.1",
    "blurhash": "^2.0.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.2.10",
    "livekit-server-sdk": "^2.18.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
