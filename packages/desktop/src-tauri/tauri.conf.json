{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trindade",
  "version": "0.1.0",
  "identifier": "com.pixelmartins.trindade",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["local"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Trindade",
    "longDescription": "Espaço de trabalho privado: canais, voz, tela, notas, tarefas e quadro colaborativo.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
