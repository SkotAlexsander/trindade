# Caddy — TLS automático, cabeçalhos e o front estático.
#
# Duas origens de propósito: a aplicação em `{$DOMINIO}` e os anexos em
# `{$DOMINIO_MIDIA}`. Um HTML malicioso servido do mesmo domínio da aplicação
# leria o que estiver acessível a ela; num domínio à parte, não lê nada.
# Ver docs/04-seguranca.md, "Servir".

{
	email {$EMAIL_ACME}
	# O log de acesso do proxy é o furo mais fácil de esquecer: não adianta
	# esconder IP na chamada se o Caddy grava tudo. Desligado.
	log {
		output discard
	}
}

import cabecalhos.caddy

{$DOMINIO} {
	import seguranca

	# A API e o gateway no mesmo processo, na mesma porta.
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /ws {
		reverse_proxy api:3000
	}

	# O front construído. `try_files` porque as rotas são do React Router: uma
	# URL profunda recarregada tem de devolver o index, não 404.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server

		# O bundle tem hash no nome; o index não pode ser guardado, senão a
		# atualização só chega quando o cache expira.
		@imutavel path /assets/*
		header @imutavel Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}
}

# Anexos e avatares. Sem aplicação nenhuma aqui — só bytes, e com a política
# mais fechada que existe.
{$DOMINIO_MIDIA} {
	header {
		Content-Security-Policy "default-src 'none'; sandbox"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Cache longo: a chave do objeto é aleatória e nunca é reaproveitada.
		Cache-Control "public, max-age=31536000, immutable"
		-Server
	}

	# O arquivo sai pela API, que confere no banco antes de servir. O storage
	# nunca é exposto direto: uma chave vazada num log daria acesso ao balde
	# inteiro.
	reverse_proxy api:3000
}

# O SFU. Só o WebSocket de sinalização passa por aqui; a mídia vai por UDP
# direto, fora do Caddy.
livekit.{$DOMINIO} {
	import seguranca
	reverse_proxy livekit:7880
}
