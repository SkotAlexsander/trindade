# Copie para .env e preencha. O .env nunca é commitado.

NODE_ENV=development
PORT=3000
# 127.0.0.1 na sua máquina; 0.0.0.0 em contêiner, senão o proxy não alcança.
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# Postgres
DATABASE_URL=postgres://trindade:trindade_dev@127.0.0.1:5432/trindade

# Ed25519. Gere com: pnpm --filter @trindade/api run keygen
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# 32 bytes em base64. Cifra o segredo TOTP no banco.
TOTP_ENCRYPTION_KEY=

# S3: MinIO em dev, R2 em produção.
S3_ENDPOINT=http://127.0.0.1:9000
S3_KEY=
S3_SECRET=
S3_BUCKET=trindade
S3_REGION=auto

# Mídia. Endereços em variável de ambiente desde a fase 1 — nunca literais no
# código — mesmo com tudo no mesmo servidor. Ver "Decisões" no CLAUDE.md.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
# O endereço do relay **não pode ser 127.0.0.1** nem em desenvolvimento.
#
# Assim que a pessoa concede a permissão de microfone, o Chrome deixa de usar
# nomes mDNS e passa a ligar os sockets ICE às interfaces de rede reais. Um
# socket ligado a 192.168.x.x não alcança o loopback, então a alocação no TURN
# simplesmente não acontece — **sem erro nenhum**: nem candidato relay, nem
# `icecandidateerror`. A chamada fica dez segundos tentando e desiste.
#
# Ponha aqui o endereço da máquina na rede local. O compose publica o coturn
# nesse endereço e o próprio coturn o anuncia como endereço externo.
TURN_EXTERNAL_IP=<endereço da máquina na rede local>
TURN_URL=turn:<endereço da máquina na rede local>:3478
# Em produção: turns:turn.exemplo.com:5349?transport=tcp
TURN_TLS_URL=
TURN_STATIC_SECRET=
# O realm do coturn e o nome no certificado TLS do relay. Em produção,
# algo como `turn.exemplo.com`. É o que `implantar.sh` substitui no modelo
# `infra/turnserver.conf`.
DOMINIO_TURN=

# Quantas contas o cadastro aberto aceita antes de fechar sozinho. O produto
# tem elenco fixo de cinco, e o painel reserva cinco espaços. Depois que o
# grupo entrar, ponha 0: daí em diante só se entra por convite.
VAGAS=5

# Métricas. Sem token, /metrics não serve nada — métrica aberta é mapa de uso.
METRICS_TOKEN=

# Alertas. Um webhook (Discord, Slack, Mattermost — o corpo serve os três) para
# três avisos: disco acima de 85%, 5xx em série, e a API fora do ar. Vazio
# desliga a vigilância inteira. Nada que sai por aqui identifica ninguém.
ALERTA_WEBHOOK=
# Qual disco vigiar. O padrão é onde a aplicação está, que num servidor único é
# o mesmo dispositivo do banco, dos backups e dos anexos.
DISCO_VIGIADO=
