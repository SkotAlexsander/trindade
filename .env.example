# Copie para .env e preencha. O .env nunca é commitado.

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Postgres
DATABASE_URL=postgres://trindade:trindade_dev@127.0.0.1:5432/trindade

# Ed25519. Gere com: pnpm --filter @trindade/api run keygen
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# 32 bytes em base64. Cifra o segredo TOTP no banco.
TOTP_ENCRYPTION_KEY=

# S3: MinIO em dev, R2 em produção.
S3_ENDPOINT=http://127.0.0.1:9000
S3_KEY=
S3_SECRET=
S3_BUCKET=trindade
S3_REGION=auto

# Mídia. Endereços em variável de ambiente desde a fase 1 — nunca literais no
# código — mesmo com tudo no mesmo servidor. Ver "Decisões" no CLAUDE.md.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
TURN_URL=turn:127.0.0.1:3478
# Em produção: turns:turn.exemplo.com:5349?transport=tcp
TURN_TLS_URL=
TURN_STATIC_SECRET=
